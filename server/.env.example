# Copy to server/.env and adjust. Never commit server/.env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stocksense?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000

# Optional: leave SMTP_HOST empty to only print OTP emails to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <no-reply@stocksense.local>"
